[Unit]
Description=AI Content Factory frontend (Next.js)
Documentation=file:///opt/ai-content-factory/current/docs/commercial-launch/phase-ii-a3-runtime-systemd-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acf
Group=acf
WorkingDirectory=/opt/ai-content-factory/current/apps/frontend
EnvironmentFile=/opt/ai-content-factory/shared/.env.production
Environment=NODE_ENV=production
Environment=FRONTEND_HOST=127.0.0.1
Environment=FRONTEND_PORT=3010
ExecStart=/usr/bin/node scripts/start-prod.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acf-frontend
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ai-content-factory/shared /tmp

[Install]
WantedBy=multi-user.target
