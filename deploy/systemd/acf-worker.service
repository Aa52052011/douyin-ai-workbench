[Unit]
Description=AI Content Factory job worker (BullMQ)
Documentation=file:///opt/ai-content-factory/current/docs/commercial-launch/phase-ii-a3-runtime-systemd-runbook.md
After=network-online.target
Wants=network-online.target
# Worker talks to Postgres and Redis only. It does not Require the backend unit.

[Service]
Type=simple
User=acf
Group=acf
WorkingDirectory=/opt/ai-content-factory/current/apps/backend
EnvironmentFile=/opt/ai-content-factory/shared/.env.production
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/worker.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=200
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acf-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ai-content-factory/shared /opt/ai-content-factory/shared/media /tmp

[Install]
WantedBy=multi-user.target
