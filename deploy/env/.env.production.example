# VPS production env. Copy to /opt/ai-content-factory/shared/.env.production
# chmod 600, owner acf:acf. Never commit real secrets. Nginx must not read this file.
# Replace YOUR_DOMAIN (example: app.example.com).

NODE_ENV=production

NEXT_PUBLIC_API_BASE=/api
BACKEND_URL=http://127.0.0.1:3001
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3010

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
PORT=3001

# Bind Postgres to 127.0.0.1 only. Do not expose 5432 publicly.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/acf_prod

# Bind Redis to 127.0.0.1 only. Optional password goes in this URL (no REDIS_PASSWORD var).
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
CORS_ORIGIN=https://YOUR_DOMAIN
COOKIE_SECURE=true
# Trust proxy is loopback-only in code. Do not set TRUST_PROXY=true.

MODEL_PROVIDER=real
MODEL_API_KEY=CHANGE_ME_MODEL_API_KEY
MODEL_BASE_URL=https://api.example-provider.com/v1
MODEL_NAME=CHANGE_ME_MODEL_NAME

MEDIA_STORAGE_ROOT=/opt/ai-content-factory/shared/media
MEDIA_COMPOSE_PROVIDER=ffmpeg
MEDIA_IMAGE_PROVIDER=wanx
MEDIA_TTS_PROVIDER=minimax-tts

WANX_API_KEY=CHANGE_ME_WANX_API_KEY
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1

MINIMAX_TTS_API_KEY=CHANGE_ME_MINIMAX_TTS_API_KEY
MINIMAX_TTS_BASE_URL=https://api.minimax.io/v1
MINIMAX_TTS_VOICE=CHANGE_ME_VOICE_ID

# Official Douyin: DEFERRED. Not required to boot email/password + manual publish.
# DOUYIN_CLIENT_KEY=
# DOUYIN_CLIENT_SECRET=
# DOUYIN_REDIRECT_URI=https://YOUR_DOMAIN/api/platform-accounts/douyin/callback
# PLATFORM_SECRET_MASTER_KEY=
