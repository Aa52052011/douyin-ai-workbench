{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:shell": "npx --yes tsx src/lib/product-shell.selfcheck.ts",
    "check:platform": "npx --yes tsx src/lib/project-platform.selfcheck.ts",
    "check:workspace": "npx --yes tsx src/lib/workspace-layout.selfcheck.ts",
    "check:product": "npx --yes tsx src/lib/product-information.selfcheck.ts",
    "check:product-intake": "npx --yes tsx src/lib/product-intake.selfcheck.ts",
    "check:positioning": "npx --yes tsx src/lib/account-positioning.selfcheck.ts",
    "check:market-research": "npx --yes tsx src/lib/market-research.selfcheck.ts",
    "check:market-intake": "npx --yes tsx src/lib/market-intake.selfcheck.ts",
    "check:market-analysis": "npx --yes tsx src/lib/market-analysis.selfcheck.ts",
    "check:strategy": "npx --yes tsx src/lib/campaign-strategy.selfcheck.ts",
    "check:confidence": "npx --yes tsx src/lib/confidence-action.selfcheck.ts",
    "check:planning": "npx --yes tsx src/lib/content-planning.selfcheck.ts",
    "check:planning-production": "npx --yes tsx src/lib/content-planning.production.selfcheck.ts",
    "check:script": "npx --yes tsx src/lib/script.selfcheck.ts",
    "check:script-queue": "npx --yes tsx src/lib/script-queue.selfcheck.ts",
    "check:video": "npx --yes tsx src/lib/video.selfcheck.ts",
    "check:publication": "npx --yes tsx src/lib/publication.selfcheck.ts",
    "check:performance": "npx --yes tsx src/lib/performance.selfcheck.ts",
    "check:overview": "npx --yes tsx src/lib/project-overview.selfcheck.ts && npx --yes tsx src/lib/intake-draft-presence.selfcheck.ts",
    "check:auth-session": "npx --yes tsx src/lib/auth-session.selfcheck.ts",
    "check:legacy-production": "npx --yes tsx src/lib/legacy-production.selfcheck.ts",
    "check:responsive": "npx --yes tsx src/lib/responsive.selfcheck.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
