generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ID：PostgreSQL native UUID，默认 UUID v7（时间有序，利于 B-tree 与分布式写入）。
// 业务表映射为 snake_case，便于 SQL、未来 RLS 与 Python 服务共用。

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  EDITOR
  VIEWER
}

enum ContentPlanStatus {
  DRAFT
  GENERATING
  READY
  CONFIRMED
  ARCHIVED
}

enum ScriptStatus {
  DRAFT
  GENERATING
  READY
  CONFIRMED
  ARCHIVED
}

enum CampaignStrategyStatus {
  READY
  CONFIRMED
  ARCHIVED
}

/// Step 13.5 — Account Content Memory snapshot lifecycle.
enum AccountMemoryStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  FAILED
}

/// Step 13.6 — Reference analysis lifecycle.
enum ReferenceAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
  INSUFFICIENT
}

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  SUBTITLE
  DOCUMENT
  SOURCE_VIDEO
  SOURCE_AUDIO
  VOICE_SAMPLE
  LOGO
  BROLL
  DIGITAL_HUMAN
  FINAL_VIDEO
  OTHER
}

enum AssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AssetSourceType {
  USER_UPLOAD
  PROJECT_UPLOAD
  SYSTEM_GENERATED
  PROVIDER_GENERATED
  REFERENCE
  SYSTEM_LIBRARY
  DERIVED
  FINAL_OUTPUT
  UNKNOWN
}

enum AssetOwnerType {
  TENANT
  PROJECT
  SYSTEM
}

enum AssetRightsStatus {
  OWNED
  LICENSED
  USER_CONFIRMED
  REFERENCE_ONLY
  UNKNOWN
  RESTRICTED
}

enum AssetConsentStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  REVOKED
}

enum AssetLinkRole {
  VIDEO_OUTPUT
  VIDEO_SOURCE
  VIDEO_AUDIO
  VIDEO_BGM
  VIDEO_SUBTITLE
  VIDEO_COVER
  VIDEO_PREVIEW
  MOVIE_SOURCE
  MOVIE_CLIP
  MOVIE_VOICEOVER
  MOVIE_SUBTITLE
  MOVIE_COVER
  MOVIE_OUTPUT
}

enum JobKind {
  VIDEO_GENERATION
  MOVIE_EDITING
  TTS_GENERATION
  SUBTITLE_GENERATION
  VIDEO_COMPOSE
  VIDEO_PUBLISH
  PUBLICATION_METRICS_SYNC
}

/// Step 13.8 — Voice identity (not a generated audio asset).
enum VoiceProfileType {
  SYSTEM
  CUSTOM
  CLONED
}

enum VoiceProfileStatus {
  DRAFT
  READY
  FAILED
  DISABLED
}

/// Step 13.8 — Digital human identity (not a generated talking-head asset).
enum DigitalHumanProfileStatus {
  DRAFT
  REGISTERING
  READY
  FAILED
  DISABLED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum Platform {
  DOUYIN
  TIKTOK
  YOUTUBE
  XIAOHONGSHU
  BILIBILI
  CHANNELS
  MOCK
}

enum PlatformAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum PublicationMode {
  API
  MANUAL
  SCHEDULED_API
}

enum PublicationStatus {
  PENDING
  UPLOADING
  SUBMITTING
  PROCESSING
  PUBLISHED
  FAILED
  UNKNOWN_EXTERNAL_STATE
  CANCELLED
}

enum SecretKind {
  PLATFORM_OAUTH
}

/// 指标如何进入系统。与 provider（谁提供）正交。禁止 SCRAPE。
enum MetricSource {
  API
  MANUAL
  IMPORT
}

/// 市场数据来源。与 MetricSource 完全独立。禁止 SCRAPE。
enum MarketSource {
  DOUYIN_OFFICIAL
  IMPORT
  MANUAL
  DESKTOP_ASSISTED
  THIRD_PARTY
}

enum MarketResearchStatus {
  DRAFT
  READY
  FAILED
}

/// V1 PublishedPost lifecycle. Orthogonal to PublicationStatus (official API machine).
enum PublishedPostLifecycleStatus {
  DRAFT
  AWAITING_MANUAL_PUBLICATION
  REGISTERED
  MONITORING_READY
  MONITORING_ACTIVE
  UNAVAILABLE
  DELETED
  ERROR
}

enum PublicationRegistrationSource {
  USER_PASTED_URL
  USER_ENTERED_POST_ID
  OFFICIAL_API_RESULT
}

enum PublicationVerificationStatus {
  USER_ASSERTED
  FORMAT_VALIDATED
  PLATFORM_VERIFIED
  VERIFICATION_FAILED
}

enum MonitoringMode {
  MANUAL_IMPORT
  OFFICIAL_API
  HYBRID
}

enum MonitoringRuntimeStatus {
  WAITING_REGISTRATION
  READY
  ACTIVE
  STOPPED
}

enum ManualExportDestinationType {
  DOWNLOAD
  USER_CHOSEN
}

enum ManualExportStatus {
  RECORDED
}

/// 全局身份。不是隔离单元，禁止挂 tenant_id。
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]
  publications  Publication[]
  enteredPublicationMetricSnapshots PublicationMetricSnapshot[]
  manualPublicationExports ManualPublicationExport[]
  videoFinalAcceptances VideoFinalAcceptance[]

  @@map("users")
}

/// 数据隔离根与未来计费根。
model Tenant {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships  Membership[]
  workspaces   Workspace[]
  projects     Project[]
  contentPlans ContentPlan[]
  scripts      Script[]
  videos       Video[]
  analytics    Analytics[]
  agentRuns    AgentRun[]
  assets           Asset[]
  assetLinks       AssetLink[]
  assetUsages      AssetUsage[]
  jobs             Job[]
  platformAccounts PlatformAccount[]
  platformSecrets  PlatformSecret[]
  publications     Publication[]
  publicationMetricSnapshots PublicationMetricSnapshot[]
  manualPublicationExports ManualPublicationExport[]
  monitoringTargets MonitoringTarget[]
  performanceAnalyses PerformanceAnalysis[]
  contentFeedbackCycles ContentFeedbackCycle[]
  productBriefs    ProductBrief[]
  marketResearches MarketResearch[]
  marketResearchSnapshots MarketResearchSnapshot[]
  marketInsights   MarketInsight[]
  campaignStrategies CampaignStrategy[]
  referenceContents  ReferenceContent[]
  referenceAnalyses  ReferenceAnalysis[]
  referencePatterns  ReferencePattern[]
  accountMemorySnapshots AccountMemorySnapshot[]
  voiceProfiles          VoiceProfile[]
  digitalHumanProfiles   DigitalHumanProfile[]
  usageEvents            UsageEvent[]
  costLedgers            CostLedger[]
  researchRequests       ResearchRequest[]
  researchEvidences      ResearchEvidence[]
  strategyRecommendations StrategyAdjustmentRecommendation[]
  cropReviewSessions     CropReviewSession[]
  humanCropApprovals     HumanCropApproval[]
  cropExecutionAuthorizations CropExecutionAuthorization[]
  cropExecutionRuns      CropExecutionRun[]
  outputStrategySelections OutputStrategySelection[]
  videoFinalAcceptances  VideoFinalAcceptance[]

  @@map("tenants")
}

/// User ↔ Tenant。同一用户不能重复加入同一租户。
model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// 协作空间。必须属于 Tenant。slug 在租户内唯一。
model Workspace {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projects     Project[]
  contentPlans ContentPlan[]
  scripts      Script[]
  videos       Video[]
  analytics    Analytics[]
  agentRuns    AgentRun[]
  assets           Asset[]
  assetLinks       AssetLink[]
  assetUsages      AssetUsage[]
  jobs             Job[]
  platformAccounts PlatformAccount[]
  platformSecrets  PlatformSecret[]
  publications     Publication[]
  publicationMetricSnapshots PublicationMetricSnapshot[]
  manualPublicationExports ManualPublicationExport[]
  monitoringTargets MonitoringTarget[]
  performanceAnalyses PerformanceAnalysis[]
  contentFeedbackCycles ContentFeedbackCycle[]
  productBriefs    ProductBrief[]
  marketResearches MarketResearch[]
  marketResearchSnapshots MarketResearchSnapshot[]
  marketInsights   MarketInsight[]
  campaignStrategies CampaignStrategy[]
  referenceContents  ReferenceContent[]
  referenceAnalyses  ReferenceAnalysis[]
  referencePatterns  ReferencePattern[]
  accountMemorySnapshots AccountMemorySnapshot[]
  voiceProfiles          VoiceProfile[]
  digitalHumanProfiles   DigitalHumanProfile[]
  usageEvents            UsageEvent[]
  costLedgers            CostLedger[]
  researchRequests       ResearchRequest[]
  researchEvidences      ResearchEvidence[]
  strategyRecommendations StrategyAdjustmentRecommendation[]
  cropReviewSessions     CropReviewSession[]
  humanCropApprovals     HumanCropApproval[]
  cropExecutionAuthorizations CropExecutionAuthorization[]
  cropExecutionRuns      CropExecutionRun[]
  outputStrategySelections OutputStrategySelection[]
  videoFinalAcceptances  VideoFinalAcceptance[]

  @@unique([id, tenantId])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("workspaces")
}

/// 业务项目。同时冗余 tenantId 与 workspaceId，并用复合外键防止串租。
model Project {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  industry    String?
  platform    String?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace    Workspace     @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  contentPlans ContentPlan[]
  scripts      Script[]
  videos       Video[]
  analytics    Analytics[]
  agentRuns    AgentRun[]
  assets       Asset[]
  assetLinks   AssetLink[]
  assetUsages  AssetUsage[]
  jobs         Job[]
  publications Publication[]
  publicationMetricSnapshots PublicationMetricSnapshot[]
  manualPublicationExports ManualPublicationExport[]
  monitoringTargets MonitoringTarget[]
  performanceAnalyses PerformanceAnalysis[]
  contentFeedbackCycles ContentFeedbackCycle[]
  productBriefs    ProductBrief[]
  marketResearches MarketResearch[]
  marketResearchSnapshots MarketResearchSnapshot[]
  marketInsights   MarketInsight[]
  campaignStrategies CampaignStrategy[]
  referenceContents  ReferenceContent[]
  referenceAnalyses  ReferenceAnalysis[]
  referencePatterns  ReferencePattern[]
  accountMemorySnapshots AccountMemorySnapshot[]
  voiceProfiles          VoiceProfile[]
  digitalHumanProfiles   DigitalHumanProfile[]
  usageEvents            UsageEvent[]
  costLedgers            CostLedger[]
  researchRequests       ResearchRequest[]
  researchEvidences      ResearchEvidence[]
  strategyRecommendations StrategyAdjustmentRecommendation[]
  cropReviewSessions     CropReviewSession[]
  humanCropApprovals     HumanCropApproval[]
  cropExecutionAuthorizations CropExecutionAuthorization[]
  cropExecutionRuns      CropExecutionRun[]
  outputStrategySelections OutputStrategySelection[]
  videoFinalAcceptances  VideoFinalAcceptance[]

  @@unique([id, tenantId])
  @@index([tenantId, workspaceId])
  @@index([tenantId, createdAt])
  @@map("projects")
}

/// 内容规划。属于 Tenant + Workspace + Project。版本不可覆盖。
model ContentPlan {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  workspaceId          String            @map("workspace_id") @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  title                String
  description          String?
  status               ContentPlanStatus @default(DRAFT)
  version              Int               @default(1)
  payload              Json              @default("{}")
  positioningSnapshot  Json              @default("{}") @map("positioning_snapshot")
  sourceAgentRunId     String?           @map("source_agent_run_id") @db.Uuid
  planningDays         Int?              @map("planning_days")
  postsPerDay          Int?              @map("posts_per_day")
  platform             String?
  usedTrendData        Boolean           @default(false) @map("used_trend_data")
  startDate            DateTime?         @map("start_date") @db.Date
  endDate              DateTime?         @map("end_date") @db.Date
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project   Project   @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  scripts   Script[]

  @@unique([id, tenantId])
  @@unique([tenantId, projectId, version])
  @@index([tenantId, workspaceId, projectId])
  @@index([tenantId, status])
  @@map("content_plans")
}

/// 脚本。挂 ContentPlan + Topic；同 Topic 版本不可覆盖。
model Script {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  workspaceId      String       @map("workspace_id") @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  contentPlanId    String?      @map("content_plan_id") @db.Uuid
  topicId          String?      @map("topic_id") @db.Uuid
  title            String
  content          String       @default("")
  version          Int          @default(1)
  status           ScriptStatus @default(DRAFT)
  payload          Json         @default("{}")
  topicSnapshot    Json         @default("{}") @map("topic_snapshot")
  sourceAgentRunId String?      @map("source_agent_run_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace   Workspace    @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project     Project      @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  contentPlan ContentPlan? @relation(fields: [contentPlanId], references: [id], onDelete: Restrict)
  videos      Video[]
  videoFinalAcceptances VideoFinalAcceptance[]

  @@unique([id, tenantId])
  @@unique([tenantId, contentPlanId, topicId, version])
  @@index([tenantId, workspaceId, projectId])
  @@index([tenantId, contentPlanId, topicId])
  @@index([tenantId, status])
  @@map("scripts")
}

/// 成片业务对象。文件在 Asset；filePath 仅兼容旧行，新业务禁止写入。
model Video {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  workspaceId   String      @map("workspace_id") @db.Uuid
  projectId     String      @map("project_id") @db.Uuid
  scriptId      String?     @map("script_id") @db.Uuid
  filePath      String?     @map("file_path")
  outputAssetId String?     @map("output_asset_id") @db.Uuid
  sourceJobId   String?     @map("source_job_id") @db.Uuid
  duration      Int?
  width         Int?
  height        Int?
  status        VideoStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace  Workspace   @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project    Project     @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  script     Script?     @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  analytics    Analytics[]
  assetLinks   AssetLink[]
  assetUsages  AssetUsage[]
  publications Publication[]
  usageEvents  UsageEvent[]
  costLedgers  CostLedger[]
  finalAcceptances VideoFinalAcceptance[]

  @@unique([id, tenantId])
  @@index([tenantId, workspaceId, projectId])
  @@index([scriptId])
  @@index([tenantId, status])
  @@map("videos")
}

/// Product-pipeline Final Production Acceptance for a Video version. Append-only current flag.
model VideoFinalAcceptance {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  scriptId             String?  @map("script_id") @db.Uuid
  videoId              String   @map("video_id") @db.Uuid
  acceptedArtifactId   String   @map("accepted_artifact_id") @db.Uuid
  variant              String   @default("VERTICAL")
  status               String   @default("ACCEPTED")
  current              Boolean  @default(true)
  acceptedAt           DateTime @map("accepted_at")
  acceptedByUserId     String   @map("accepted_by_user_id") @db.Uuid
  supersededAt         DateTime? @map("superseded_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project  Project   @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  script   Script?   @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  video    Video     @relation(fields: [videoId, tenantId], references: [id, tenantId], onDelete: Restrict)
  artifact Asset     @relation(fields: [acceptedArtifactId, tenantId], references: [id, tenantId], onDelete: Restrict)
  acceptedBy User    @relation(fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, videoId])
  @@index([tenantId, projectId, scriptId, current])
  @@index([tenantId, current])
  @@map("video_final_acceptances")
}

/// 统一文件元数据。二进制在 StorageProvider，不进 Postgres。
/// Step 13.3：Asset Library foundation fields are additive with safe defaults.
model Asset {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  workspaceId       String      @map("workspace_id") @db.Uuid
  projectId         String      @map("project_id") @db.Uuid
  type              AssetType
  status            AssetStatus @default(PENDING)
  storageProvider   String      @map("storage_provider")
  storageKey        String      @map("storage_key")
  originalFilename  String?     @map("original_filename")
  mimeType          String?     @map("mime_type")
  size              Int?
  duration          Int?
  width             Int?
  height            Int?
  metadata          Json        @default("{}")
  /// Library / rights / rights (13.3)
  sourceType        AssetSourceType    @default(UNKNOWN) @map("source_type")
  ownerType         AssetOwnerType     @default(PROJECT) @map("owner_type")
  referenceOnly     Boolean            @default(false) @map("reference_only")
  reusable          Boolean            @default(true)
  rightsStatus      AssetRightsStatus  @default(UNKNOWN) @map("rights_status")
  consentStatus     AssetConsentStatus @default(NOT_REQUIRED) @map("consent_status")
  libraryVisible    Boolean            @default(false) @map("library_visible")
  usedCount         Int                @default(0) @map("used_count")
  lastUsedAt        DateTime?          @map("last_used_at")
  contentHash       String?            @map("content_hash")
  createdByUserId   String?            @map("created_by_user_id") @db.Uuid
  sourceUrl         String?            @map("source_url")
  provider          String?
  providerAssetId   String?            @map("provider_asset_id")
  sourceAssetId     String?            @map("source_asset_id") @db.Uuid
  generatedFromJobId String?           @map("generated_from_job_id") @db.Uuid
  qualityScore      Float?             @map("quality_score")
  tags              Json               @default("[]")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace  Workspace   @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project    Project     @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assetLinks AssetLink[]
  usages     AssetUsage[]
  referenceContents ReferenceContent[]
  voiceSampleProfiles VoiceProfile[] @relation("VoiceProfileSample")
  digitalHumanSources DigitalHumanProfile[] @relation("DigitalHumanSource")
  videoFinalAcceptances VideoFinalAcceptance[]

  @@unique([id, tenantId])
  @@unique([tenantId, storageProvider, storageKey])
  @@index([tenantId, workspaceId, projectId, type])
  @@index([tenantId, status])
  @@index([tenantId, libraryVisible, projectId])
  @@index([tenantId, sourceType])
  @@map("assets")
}

/// Production usage of an Asset (not list/view). Idempotent per asset+video+usageType.
model AssetUsage {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  videoId     String?  @map("video_id") @db.Uuid
  jobId       String?  @map("job_id") @db.Uuid
  usageType   String   @map("usage_type")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project   Project?  @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  asset     Asset     @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Restrict)
  video     Video?    @relation(fields: [videoId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, assetId, videoId, usageType])
  @@index([tenantId, assetId])
  @@index([tenantId, videoId])
  @@map("asset_usages")
}

/// 媒体耗时任务。与 AgentRun 分离；retry 创建新行。
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  kind        JobKind
  status      JobStatus @default(PENDING)
  provider    String?
  model       String?
  input       Json      @default("{}")
  output      Json      @default("{}")
  error       Json?
  progress    Int       @default(0)
  requestId   String    @map("request_id")
  scriptId    String?   @map("script_id") @db.Uuid
  videoId     String?   @map("video_id") @db.Uuid
  agentRunId      String?   @map("agent_run_id") @db.Uuid
  lockedAt        DateTime? @map("locked_at")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  attempt         Int       @default(0)
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
