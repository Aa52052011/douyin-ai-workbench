/// Strategy adjustment suggestion. Never mutates confirmed CampaignStrategy rows.
model StrategyAdjustmentRecommendation {
  id              String                         @id @default(uuid(7)) @db.Uuid
  tenantId        String                         @map("tenant_id") @db.Uuid
  workspaceId     String                         @map("workspace_id") @db.Uuid
  projectId       String                         @map("project_id") @db.Uuid
  version         Int
  status          StrategyRecommendationStatus   @default(ACTIVE)
  payload         Json                           @default("{}")
  sourceWatermark String                         @map("source_watermark")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project   Project   @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, projectId, version])
  @@unique([tenantId, projectId, sourceWatermark])
  @@index([tenantId, workspaceId, projectId, status])
  @@map("strategy_adjustment_recommendations")
}

enum CropReviewSessionDbStatus {
  CREATED
  PREVIEW_PENDING
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  INVALIDATED
}

enum CropReviewHumanDecisionDb {
  NOT_REVIEWED
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum HumanCropApprovalDbStatus {
  ACTIVE
  REVOKED
  INVALIDATED
}

enum CropExecutionAuthorizationDbStatus {
  ACTIVE
  CONSUMED
  REVOKED
  INVALIDATED
}

enum CropExecutionRunDbStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// B2-14 durable crop review session. Not a human approval.
model CropReviewSession {
  id                   String                     @id @default(uuid(7)) @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  workspaceId          String                     @map("workspace_id") @db.Uuid
  projectId            String                     @map("project_id") @db.Uuid
  assetId              String                     @map("asset_id") @db.Uuid
  candidateId          String                     @map("candidate_id")
  candidateVersion     String                     @map("candidate_version")
  reviewPacketVersion  String                     @map("review_packet_version")
  previewId            String?                    @map("preview_id")
  previewVersion       String                     @map("preview_version")
  status               CropReviewSessionDbStatus
  backgroundTreatment  String                     @map("background_treatment")
  requiredWarningsJson Json                       @default("[]") @map("required_warnings_json")
  checklistJson        Json                       @default("[]") @map("checklist_json")
  humanDecision        CropReviewHumanDecisionDb  @map("human_decision")
  createdByUserId      String?                    @map("created_by_user_id") @db.Uuid
  reviewedByUserId     String?                    @map("reviewed_by_user_id") @db.Uuid
  expiresAt            DateTime?                  @map("expires_at")
  invalidatedAt        DateTime?                  @map("invalidated_at")
  invalidationReason   String?                    @map("invalidation_reason")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project   Project   @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approvals HumanCropApproval[]
  outputStrategySelections OutputStrategySelection[]

  @@unique([id, tenantId])
  @@index([tenantId, workspaceId, projectId])
  @@index([tenantId, assetId])
  @@index([tenantId, status])
  @@map("crop_review_sessions")
}

/// Immutable human crop approval facts. Do not UPDATE candidate/preview/source.
model HumanCropApproval {
  id                      String                     @id @default(uuid(7)) @db.Uuid
  tenantId                String                     @map("tenant_id") @db.Uuid
  workspaceId             String                     @map("workspace_id") @db.Uuid
  projectId               String                     @map("project_id") @db.Uuid
  reviewSessionId         String                     @map("review_session_id") @db.Uuid
  assetId                 String                     @map("asset_id") @db.Uuid
  candidateId             String                     @map("candidate_id")
  candidateVersion        String                     @map("candidate_version")
  reviewPacketVersion     String                     @map("review_packet_version")
  previewId               String                     @map("preview_id")
  previewVersion          String                     @map("preview_version")
  backgroundTreatment     String                     @map("background_treatment")
  acceptedWarningsJson    Json                       @default("[]") @map("accepted_warnings_json")
  confirmedChecklistJson  Json                       @default("[]") @map("confirmed_checklist_json")
  approvalSource          String                     @map("approval_source")
  approvedByUserId        String                     @map("approved_by_user_id") @db.Uuid
  approvedAt              DateTime                   @map("approved_at")
  clientActionId          String                     @map("client_action_id")
  status                  HumanCropApprovalDbStatus
  invalidatedAt           DateTime?                  @map("invalidated_at")
  invalidationReason      String?                    @map("invalidation_reason")
  createdAt               DateTime                   @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace     Workspace         @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project       Project           @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewSession CropReviewSession @relation(fields: [reviewSessionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authorizations CropExecutionAuthorization[]
  executionRuns  CropExecutionRun[]

  @@unique([id, tenantId])
  @@unique([tenantId, clientActionId])
  @@index([tenantId, workspaceId, projectId])
  @@index([tenantId, reviewSessionId])
  @@index([tenantId, status])
  @@map("human_crop_approvals")
}

model CropExecutionAuthorization {
  id                   String                             @id @default(uuid(7)) @db.Uuid
  tenantId             String                             @map("tenant_id") @db.Uuid
  workspaceId          String                             @map("workspace_id") @db.Uuid
  projectId            String                             @map("project_id") @db.Uuid
  approvalId           String                             @map("approval_id") @db.Uuid
  reviewSessionId      String                             @map("review_session_id") @db.Uuid
  assetId              String                             @map("asset_id") @db.Uuid
  candidateId          String                             @map("candidate_id")
  candidateVersion     String                             @map("candidate_version")
  previewVersion       String                             @map("preview_version")
  backgroundTreatment  String                             @map("background_treatment")
  executionPlanVersion String                             @map("execution_plan_version")
  clientRequestId      String                             @map("client_request_id")
  status               CropExecutionAuthorizationDbStatus
  createdAt            DateTime                           @default(now()) @map("created_at")
  consumedAt           DateTime?                          @map("consumed_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace Workspace          @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project   Project            @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approval  HumanCropApproval  @relation(fields: [approvalId, tenantId], references: [id, tenantId], onDelete: Restrict)
  runs      CropExecutionRun[]

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, approvalId])
  @@index([tenantId, status])
  @@map("crop_execution_authorizations")
}

model CropExecutionRun {
  id                String                   @id @default(uuid(7)) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  workspaceId       String                   @map("workspace_id") @db.Uuid
  projectId         String                   @map("project_id") @db.Uuid
  approvalId        String                   @map("approval_id") @db.Uuid
  authorizationId   String                   @map("authorization_id") @db.Uuid
  assetId           String                   @map("asset_id") @db.Uuid
  candidateId       String                   @map("candidate_id")
  clientRequestId   String                   @map("client_request_id")
  status            CropExecutionRunDbStatus
  inputRef          String                   @map("input_ref")
  tempOutputRef     String?                  @map("temp_output_ref")
  finalOutputRef    String?                  @map("final_output_ref")
  ffmpegExitCode    Int?                     @map("ffmpeg_exit_code")
  validationJson    Json?                    @map("validation_json")
  failureCode       String?                  @map("failure_code")
  failureMessageSanitized String?            @map("failure_message_sanitized")
  startedAt         DateTime?                @map("started_at")
  completedAt       DateTime?                @map("completed_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace       Workspace                   @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project         Project                     @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approval        HumanCropApproval           @relation(fields: [approvalId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authorization   CropExecutionAuthorization  @relation(fields: [authorizationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, authorizationId])
  @@index([tenantId, status])
  @@map("crop_execution_runs")
}

/// B2-15I human-selected output strategy. Not visual approval and not production authorization.
model OutputStrategySelection {
  id                   String   @id @default(uuid(7)) @map("selection_id") @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  contentId            String?  @map("content_id")
  reviewSessionId      String   @map("review_session_id") @db.Uuid
  sourceVisualType     String   @map("source_visual_type")
  selectedStrategy     String   @map("selected_strategy")
  selectedProfileIds   Json     @map("selected_profile_ids")
  selectionSource      String   @map("selection_source")
  humanFeedbackRef     String?  @map("human_feedback_ref")
  verticalPreference   String?  @map("vertical_preference")
  landscapePreference  String?  @map("landscape_preference")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace     Workspace         @relation(fields: [workspaceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  project       Project           @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewSession CropReviewSession @relation(fields: [reviewSessionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, reviewSessionId])
  @@index([tenantId, workspaceId, projectId])
  @@map("output_strategy_selections")
}

