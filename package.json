{
  "name": "ai-content-factory",
  "version": "1.0.0",
  "private": true,
  "description": "AI Content Factory — AI 抖音智能体工作台 monorepo",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "database",
    "workers"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run start:dev -w backend",
    "dev:worker": "npm run start:dev -w workers",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "lint:frontend": "npm run lint -w frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local:init": "node scripts/local-postgres.mjs init",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "db:generate": "npm run generate -w database",
    "db:migrate": "npm run migrate:dev -w database",
    "db:migrate:deploy": "npm run migrate:deploy -w database",
    "db:test": "npm test -w database"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
