# 复制为 .env 后按本机修改。不要提交真实密码或生产 JWT 密钥。
# Docker Compose 开发库：localhost:5432 / acf_dev
# Windows 持久本地 cluster：127.0.0.1:55432 / acf_dev（npm run db:local:start）
DATABASE_URL="postgresql://acf:acf@localhost:5432/acf_dev?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
# ---------------------------------------------------------------------------
# Web V1 RC deployment profiles (refresh token = HttpOnly cookie)
#
# LOCAL_RC (localhost / http evaluation only):
#   COOKIE_SECURE=false
#   CORS_ORIGIN=http://localhost:3000
#
# PUBLIC_HTTPS (any public or LAN HTTPS deployment):
#   COOKIE_SECURE=true
#   CORS_ORIGIN=https://your-frontend.example.com
#   production 禁止 CORS_ORIGIN=*（除非代码明确安全设计允许；当前不允许）
#
# 不要把真实 secret 写入本文件。不要提交真实 .env。
# ---------------------------------------------------------------------------
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:3000"
# 留空则 Backend 进程内执行 system.echo。有 Python 服务后再填写。
AI_ENGINE_URL=""
AI_ENGINE_SECRET=""
# 仅调试时设为 true；默认不记录完整 Prompt / 模型响应。
AGENT_DEBUG_PROMPTS="false"
# 模型选择。development 可设 mock；production 禁止 mock，必须 real 或 router-one。
# 测试环境强制 mock，不需要真实 Key。
MODEL_PROVIDER="mock"
# 真实模型（OpenAI-compatible / Router One）。MODEL_PROVIDER=real 时三字段都必填。
# 不要把真实 API Key 写入本文件。
MODEL_API_KEY="replace-with-model-api-key"
MODEL_BASE_URL="https://api.router.one/v1"
MODEL_NAME="openai/gpt-5.4-mini"
# 本地对象存储根目录。不要指向仓库源码目录以外的敏感路径。
MEDIA_STORAGE_ROOT="./storage"
# 平台账号凭据主密钥：恰好 32 字节的 base64。不要截断或填充。不要提交真实密钥。
PLATFORM_SECRET_MASTER_KEY=""
# Job 队列。Worker 进程必须配置。不要把真实密码写入仓库。
REDIS_URL="redis://127.0.0.1:6379"
# Worker lease。heartbeat 必须小于 lease。
JOB_LEASE_TIMEOUT_MS="90000"
JOB_HEARTBEAT_INTERVAL_MS="15000"
# 成片合成。development 可显式 mock；production 必须 ffmpeg，禁止 silent mock。
MEDIA_COMPOSE_PROVIDER="mock"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
FFMPEG_TIMEOUT_MS="180000"
FFMPEG_MAX_CONCURRENCY="1"
# 配音。development 可显式 mock；production 必须 openai-tts 或 minimax-tts，禁止 silent mock。
MEDIA_TTS_PROVIDER="mock"
TTS_BASE_URL=""
TTS_API_KEY=""
TTS_MODEL=""
TTS_VOICE=""
TTS_FORMAT="mp3"
TTS_TIMEOUT_MS="60000"
TTS_MAX_RESPONSE_BYTES="10485760"
RUN_REAL_TTS_TESTS="false"
# 抖音开放平台 OAuth（Authorization Code）。CLIENT_SECRET 只存在环境变量，禁止写入 DB / 返回 API / 打日志。
# 本地 http://127.0.0.1 一般不能作为官方正式 redirect URI。生产应使用已登记的 HTTPS callback。
# Step 8.6 默认不发起真实 Douyin 请求。真实验证属于 Step 8.6R，需自行填写后明确批准。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_OAUTH_BASE_URL="https://open.douyin.com"
DOUYIN_API_BASE_URL="https://open.douyin.com"
# 视觉。必须显式选择 color-background（本地真实 PNG）或 wanx。测试环境强制本地。
# production 允许 color-background；unknown / missing 会启动失败。
MEDIA_IMAGE_PROVIDER="color-background"
VISUAL_MAX_CONCURRENCY="1"
# 通义万相 wan2.6-t2i（华北2 北京）。API Key 必须与北京 Endpoint / 业务空间同地域，不可混用。
# WANX_BASE_URL 填写完整业务空间 base，例如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# 不要把真实 API Key 或 WorkspaceId 写入本文件。
WANX_BASE_URL=
WANX_API_KEY=
WANX_MODEL=wan2.6-t2i
WANX_SIZE=
WANX_TIMEOUT_MS=
WANX_MAX_RESPONSE_BYTES=
# MiniMax 同步 TTS。测试默认 mock，不调用真实 MiniMax，也不会产生费用。
MINIMAX_TTS_BASE_URL=""
MINIMAX_TTS_API_KEY=""
MINIMAX_TTS_MODEL="speech-2.8-turbo"
MINIMAX_TTS_VOICE=""
MINIMAX_TTS_FORMAT="mp3"
MINIMAX_TTS_LANGUAGE_BOOST="Chinese"
MINIMAX_TTS_TIMEOUT_MS=""
MINIMAX_TTS_MAX_RESPONSE_BYTES=""
