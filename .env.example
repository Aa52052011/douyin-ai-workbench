# Copy to `.env` and replace placeholders. Never commit real secrets.
# PostgreSQL and Redis must listen on loopback only on a single VPS (not the public internet).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# production | development | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Browser API prefix. SAME_DOMAIN_PATH_BASED: keep `/api` (Next rewrites to the backend).
NEXT_PUBLIC_API_BASE=/api
# Loopback URL used by Next rewrites. Not the public browser origin.
# Required when NODE_ENV=production (`next start`).
BACKEND_URL=http://127.0.0.1:3001
# Bound by `npm run start -w frontend` (scripts/start-prod.mjs). Recommended behind Nginx: loopback.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3010

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Listen address. Production default is 127.0.0.1 when unset. Do not publish this port publicly.
BACKEND_HOST=127.0.0.1
# Prefer BACKEND_PORT. PORT is the legacy alias used by existing local RC.
BACKEND_PORT=3001
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Placeholder only. Replace USERNAME, PASSWORD, DATABASE_NAME. Bind Postgres to 127.0.0.1.
# Local Windows RC cluster uses port 55432; VPS/Compose typically 5432.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/DATABASE_NAME

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# ioredis / BullMQ URL. Password is only used if present in this URL; there is no separate REDIS_PASSWORD variable.
# Bind Redis to 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Access JWT signing secret. Refresh tokens are opaque DB-backed values plus httpOnly cookie `acf_rt`.
# There is no separate JWT_REFRESH_SECRET in this codebase.
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Optional TTL overrides (seconds). Defaults: access 900, refresh 2592000.
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=2592000
# Public HTTPS origin(s) for the browser app. Comma-separated. Wildcard `*` is rejected.
# Production requires CORS_ORIGIN or CORS_ORIGINS. Local RC UI is often :3010; `next dev` is :3000.
CORS_ORIGIN=http://localhost:3010
# CORS_ORIGINS=https://app.example.com
# Production (NODE_ENV=production) requires COOKIE_SECURE=true (fail-fast). Local RC may omit it.
COOKIE_SECURE=false
# Express trust proxy is fixed to loopback. Do not set TRUST_PROXY=true (rejected at startup).
# TRUST_PROXY=false

# ---------------------------------------------------------------------------
# AI / Model Provider
# ---------------------------------------------------------------------------
MODEL_PROVIDER=real
MODEL_API_KEY=CHANGE_ME_MODEL_API_KEY
MODEL_BASE_URL=https://api.example-provider.com/v1
MODEL_NAME=CHANGE_ME_MODEL_NAME
# MODEL_FALLBACK_1_NAME=
# MODEL_CIRCUIT_FAILURE_THRESHOLD=2
# MODEL_CIRCUIT_COOLDOWN_MS=900000

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Absolute directory on the VPS, e.g. /var/lib/acf/media . Required in production.
MEDIA_STORAGE_ROOT=./storage
MEDIA_COMPOSE_PROVIDER=ffmpeg
MEDIA_IMAGE_PROVIDER=wanx
MEDIA_TTS_PROVIDER=minimax-tts
# MEDIA_MAX_UPLOAD_BYTES=134217728
# FFmpeg is not bundled. Empty = ffmpeg / ffprobe on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# FFMPEG_TIMEOUT_MS=180000
# FFMPEG_MAX_CONCURRENCY=1

WANX_API_KEY=CHANGE_ME_WANX_API_KEY
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# WANX_MODEL=
# WANX_SIZE=
# WANX_TIMEOUT_MS=
# WANX_MAX_RESPONSE_BYTES=

MINIMAX_TTS_API_KEY=CHANGE_ME_MINIMAX_TTS_API_KEY
MINIMAX_TTS_BASE_URL=https://api.minimax.io/v1
MINIMAX_TTS_VOICE=CHANGE_ME_VOICE_ID
# MINIMAX_TTS_MODEL=
# MINIMAX_TTS_FORMAT=mp3
# MINIMAX_TTS_LANGUAGE_BOOST=Chinese
# MINIMAX_TTS_TIMEOUT_MS=
# MINIMAX_TTS_MAX_RESPONSE_BYTES=

# OpenAI-compatible TTS only if MEDIA_TTS_PROVIDER=openai-tts
# TTS_API_KEY=
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_VOICE=

# Production forbids mock compose / mock digital-human / mock voice-clone.
# MEDIA_DIGITAL_HUMAN_PROVIDER=disabled
# MEDIA_VOICE_CLONE_PROVIDER=disabled

# ---------------------------------------------------------------------------
# Jobs / worker (same env file as backend)
# ---------------------------------------------------------------------------
# ACF_JOB_QUEUE_NAME=acf-jobs
# JOB_LEASE_TIMEOUT_MS=90000
# JOB_HEARTBEAT_INTERVAL_MS=15000
# Single-VPS worker lock (Redis SET NX). Default key acf:worker:singleton, TTL 30s, heartbeat 10s.
# ACF_WORKER_LOCK_KEY=acf:worker:singleton
# ACF_WORKER_LOCK_TTL_MS=30000
# ACF_WORKER_LOCK_HEARTBEAT_MS=10000
# ACF_WORKER_SINGLETON=false

# ---------------------------------------------------------------------------
# Douyin (Official integration: DEFERRED — not a SINGLE_VPS_WEB_RC boot blocker)
# ---------------------------------------------------------------------------
# DOUYIN_CLIENT_KEY=
# DOUYIN_CLIENT_SECRET=
# DOUYIN_REDIRECT_URI=https://app.example.com/api/platform-accounts/douyin/callback
# DOUYIN_OAUTH_BASE_URL=https://open.douyin.com
# DOUYIN_API_BASE_URL=https://open.douyin.com

# ---------------------------------------------------------------------------
# Platform Security (required only when storing platform OAuth secrets)
# ---------------------------------------------------------------------------
# 32-byte key, standard Base64. Not required to boot email/password + manual publish.
# PLATFORM_SECRET_MASTER_KEY=

# Optional external agent engine. Not required when using in-process model provider.
# AI_ENGINE_URL=
# AI_ENGINE_SECRET=

# Optional crop-review filesystem root. Defaults to process cwd.
# CROP_REVIEW_REPO_ROOT=
